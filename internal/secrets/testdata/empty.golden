keys:
  - &host_myhost age1myhost
  - &user_jdoe_myhost age1jdoemyhost
creation_rules:
  - path_regex: ^hosts/myhost\.yaml$
    key_groups:
      - age:
          - *host_myhost
  - path_regex: ^host-users/myhost-jdoe\.yaml$
    key_groups:
      - age:
          - *host_myhost
          - *user_jdoe_myhost
