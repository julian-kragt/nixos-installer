keys:
  - &host_atlas age1atlas
  - &user_jkragt_atlas age1jkragtatlas
creation_rules:
  - path_regex: ^hosts/atlas\.yaml$
    key_groups:
      - age:
          - *host_atlas
  - path_regex: ^host-users/atlas-jkragt\.yaml$
    key_groups:
      - age:
          - *host_atlas
          - *user_jkragt_atlas
