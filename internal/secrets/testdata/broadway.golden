keys:
  - &host_atlas age10nwtg9l3pjdfn8k8mtnhsekfdaq6f807l0qgmultvxddfszh6ayqflkgka
  - &user_jkragt age10myc9vc0jgjk7c5l6seeawngqvzvu2g8tmsdqkz5hne7rsa284wsh0yr9p
  - &host_workhorse age19xd246tvvdw57640w4w4uvu74r9c5wl6999flktw7y0auwwpgdqqfh2m8f
  - &host_broadway age1broadway
  - &user_jkragt_broadway age1jb
  - &user_media_broadway age1mb
creation_rules:
  - path_regex: ^hosts/atlas\.yaml$
    key_groups:
      - age:
          - *host_atlas
  - path_regex: ^hosts/workhorse\.yaml$
    key_groups:
      - age:
          - *host_workhorse
  - path_regex: ^host-users/atlas-jkragt\.yaml$
    key_groups:
      - age:
          - *host_atlas
          - *user_jkragt
  - path_regex: ^host-users/workhorse-jkragt\.yaml$
    key_groups:
      - age:
          - *host_workhorse
          - *user_jkragt
  - path_regex: ^hosts/broadway\.yaml$
    key_groups:
      - age:
          - *host_broadway
  - path_regex: ^host-users/broadway-jkragt\.yaml$
    key_groups:
      - age:
          - *host_broadway
          - *user_jkragt_broadway
  - path_regex: ^host-users/broadway-media\.yaml$
    key_groups:
      - age:
          - *host_broadway
          - *user_media_broadway
