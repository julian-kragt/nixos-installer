keys:
  - &host_myhost age1myhost
  - &user_jdoe age10myc9vc0jgjk7c5l6seeawngqvzvu2g8tmsdqkz5hne7rsa284wsh0yr9p
  - &host_workstation age19xd246tvvdw57640w4w4uvu74r9c5wl6999flktw7y0auwwpgdqqfh2m8f
  - &user_jdoe_myhost age1jdoemyhost
creation_rules:
  - path_regex: ^hosts/myhost\.yaml$
    key_groups:
      - age:
          - *host_myhost
  - path_regex: ^hosts/workstation\.yaml$
    key_groups:
      - age:
          - *host_workstation
  - path_regex: ^host-users/myhost-jdoe\.yaml$
    key_groups:
      - age:
          - *host_myhost
          - *user_jdoe_myhost
  - path_regex: ^host-users/workstation-jdoe\.yaml$
    key_groups:
      - age:
          - *host_workstation
          - *user_jdoe
