      - age:
          - *host_nexthost
  - path_regex: ^host-users/nexthost-jdoe\.yaml$
    key_groups:
      - age:
          - *host_nexthost
          - *user_jdoe_nexthost
  - path_regex: ^host-users/nexthost-media\.yaml$
