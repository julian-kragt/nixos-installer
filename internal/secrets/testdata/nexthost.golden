keys:
  - &host_myhost age10nwtg9l3pjdfn8k8mtnhsekfdaq6f807l0qgmultvxddfszh6ayqflkgka
  - &user_jdoe age10myc9vc0jgjk7c5l6seeawngqvzvu2g8tmsdqkz5hne7rsa284wsh0yr9p
  - &host_workstation age19xd246tvvdw57640w4w4uvu74r9c5wl6999flktw7y0auwwpgdqqfh2m8f
  - &host_nexthost age1nexthost
